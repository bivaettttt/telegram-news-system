# ============================================================
# Telegram Bot
# ============================================================
BOT_TOKEN=your_bot_token_here

# Target channels (get IDs with get_chat_id.py)
CHANNEL_WORLD_ID=-1001234567890
CHANNEL_ECONOMY_ID=-1001234567891

# Moderation chat (optional — omit to disable moderation)
MODERATION_CHAT_ID=-1001234567892

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=newsbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# LLM (OpenAI or compatible)
# ============================================================
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LLM_REWRITE_ENABLED=true
LLM_TIMEOUT_SECONDS=90

# ============================================================
# Pipeline tuning (optional)
# ============================================================
PIPELINE_INTERVAL_MINUTES=15
MAX_POSTS_PER_RUN=15
MAX_POSTS_PER_CHANNEL=6
MIN_QUALITY_SCORE=4
AUTO_PUBLISH_CONFIDENCE_THRESHOLD=0.55
